MYSQL_DATABASE=student_management
DB_URL=jdbc:mysql://localhost:3306/student_management?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=student
DB_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
CORS_ORIGIN=http://localhost:8080
APP_PORT=8080
DB_POOL_SIZE=10
JWT_SECRET=replace-with-at-least-32-random-bytes-before-running
SMS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
SMS_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SMS_MAIL_HOST=smtp.example.com
SMS_MAIL_PORT=587
SMS_MAIL_USERNAME=your-smtp-username
SMS_MAIL_PASSWORD=replace-with-your-smtp-password
SMS_MAIL_FROM=no-reply@example.com
SMS_MAIL_AUTH=true
SMS_MAIL_STARTTLS=true
SMS_PUBLIC_APP_URL=http://localhost:8080/login
